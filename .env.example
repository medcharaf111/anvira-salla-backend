# Server
PORT=8080
FRONTEND_URL=http://localhost:3000

# Postgres (Railway provides this automatically when you add a Postgres plugin)
DATABASE_URL=postgresql://user:pass@host:5432/anvira

# Salla OAuth (https://docs.salla.dev — get from partners.salla.dev)
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=http://localhost:3000/api/auth/salla/callback
SALLA_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta — https://developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# AI provider (OpenAI or Anthropic)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
