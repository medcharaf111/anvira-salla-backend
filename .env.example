# Server
PORT=8080
FRONTEND_URL=http://localhost:3000

# MOCK_MODE=true short-circuits Salla + WhatsApp APIs and seeds demo data.
# Set false in production once real Salla/WhatsApp credentials are provisioned.
MOCK_MODE=true

# Postgres connection string.
#   Recommended: Supabase pooler URL (Connect → ORM → Drizzle).
#   Either pooler mode works because the postgres-js driver is configured
#   with prepare:false (see src/db/index.ts).
#   Format: postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase (optional — for Realtime, Storage, Auth admin features.
# Drizzle handles SQL/migrations via DATABASE_URL above; these env vars unlock Supabase SDK features.)
# https://supabase.com/dashboard/project/<project>/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Salla OAuth (https://docs.salla.dev — get from partners.salla.dev)
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_REDIRECT_URI=http://localhost:3000/api/auth/salla/callback
SALLA_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta — https://developers.facebook.com/docs/whatsapp/cloud-api)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# AI provider (Google Gemini)
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
